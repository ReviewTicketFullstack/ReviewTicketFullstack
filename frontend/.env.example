# 이 파일을 .env.local 로 복사한 뒤 자기 환경에 맞게 채운다.
#
#   copy .env.example .env.local
#
# .env.local 은 .gitignore 의 *.local 에 걸려 커밋되지 않는다.
# 그래서 주소가 바뀌어도 각자 자기 파일만 고치면 되고, 개인 설정이
# 커밋에 딸려 들어가지 않는다.

# 개발 서버가 /api 요청을 넘길 백엔드 주소.
#
#   자기 PC 에서 백엔드를 띄우는 경우 : http://localhost:60921
#   공용 서버를 쓰는 경우             : http://서버_주소:60921
#
# 비워두면 http://localhost:60921 을 쓴다.
VITE_API_TARGET=
